# Application Environment
APP_NAME="Hawlwadaag Primary and Secondary School Management System"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://postgres:123@localhost:5432/sms
# MySQL alternative:
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/sms?charset=utf8mb4

# Security & JWT Authentication
JWT_SECRET=hawlwadaag_super_secret_jwt_key_change_in_production_2026_xyz
