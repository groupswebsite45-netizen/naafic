# Application Environment
APP_NAME="Hawlwadaag Primary and Secondary School Management System"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL=postgresql+psycopg2://postgres:123@localhost:5432/hawlwadaag_school_db

# Security & JWT Authentication
JWT_SECRET=hawlwadaag_super_secret_jwt_key_change_in_production_2026_xyz
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Initial Admin Seed Credentials (Used only during initial migration/seed)
INITIAL_ADMIN_EMAIL=admin@hawlwadaagschool.edu.so
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin@Hawlwadaag2026
INITIAL_ADMIN_FULL_NAME=System Administrator
